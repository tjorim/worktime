{
  "name": "worktime",
  "version": "4.7.0",
  "description": "Team Shift Tracker + Time Off Management for 5-team continuous (24/7) schedules",
  "keywords": [
    "continuous",
    "hday",
    "shift-tracker",
    "team-schedule",
    "time-off",
    "vacation-tracker",
    "worktime"
  ],
  "homepage": "https://github.com/tjorim/worktime#readme",
  "bugs": {
    "url": "https://github.com/tjorim/worktime/issues"
  },
  "license": "Apache-2.0",
  "author": "Jorim Tielemans <tielemans.jorim@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjorim/worktime.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vp dev",
    "dev:playwright:start": "vp dev --host 0.0.0.0 --port 4173",
    "build": "npm run paraglide:compile && tsc -b && vp build",
    "preview": "vp preview",
    "typecheck": "npm run paraglide:compile && tsc -b --noEmit",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "lint": "vp lint",
    "format": "vp fmt .",
    "test": "vp test run",
    "test:ui": "vp test --ui",
    "test:watch": "vp test",
    "generate-changelog": "tsx scripts/generate-changelog.ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "check-version-consistency": "tsx scripts/check-version-consistency.ts"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.20",
    "frappe-gantt": "^1.2.2",
    "react": "^19.2.4",
    "react-bootstrap": "^3.0.0-beta.5",
    "react-dom": "^19.2.4",
    "react-select": "^5.10.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.15.0",
    "@inlang/plugin-m-function-matcher": "^2.2.2",
    "@inlang/plugin-message-format": "^4.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.3.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.0",
    "canvas": "^3.2.1",
    "happy-dom": "^20.8.3",
    "lightningcss": "^1.31.1",
    "sass": "^1.97.3",
    "terser": "^5.46.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "@vitejs/plugin-react": {
      "vite": "$vite"
    },
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "npm@11.11.1"
}
