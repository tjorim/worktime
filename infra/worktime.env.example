# =============================================================================
# Worktime Backend — Production Environment Configuration
# =============================================================================
# Reference file for the infra stack (/opt/apps/infra).
# Copy to worktime.env and fill in real values before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Share Directory (mounted network share for .hday files)
# -----------------------------------------------------------------------------
SHARE_DIR=/data/hday_files

# -----------------------------------------------------------------------------
# CORS — must include the frontend domain
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. In production, use explicit HTTPS
# origins. The frontend domain (SUPERTOKENS_WEBSITE_DOMAIN) MUST be included.
#
# Example: https://worktime.tjor.im
CORS_ORIGINS=https://worktime.tjor.im

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL=10

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_ENABLED=true
DATABASE_URL=postgresql+asyncpg://worktime:CHANGE_ME@postgres:5432/worktime
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Authentication — SuperTokens
# -----------------------------------------------------------------------------
# Connection to the self-hosted SuperTokens core.
SUPERTOKENS_CONNECTION_URI=http://supertokens:3567

# API key shared with the SuperTokens core (must match API_KEYS in the core
# configuration). Leave empty only for development without an API key.
SUPERTOKENS_API_KEY=CHANGE_ME

# Public URL of this backend API (used for cookie domain / CORS by SuperTokens).
SUPERTOKENS_API_DOMAIN=https://api.tjor.im

# Public URL of the frontend (used for cookie domain / redirect URLs).
SUPERTOKENS_WEBSITE_DOMAIN=https://worktime.tjor.im

# Path prefix for SuperTokens API routes (default: /auth).
SUPERTOKENS_API_BASE_PATH=/auth

# Path prefix for SuperTokens frontend routes on the website domain (default: /auth).
SUPERTOKENS_WEBSITE_BASE_PATH=/auth
