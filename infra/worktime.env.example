# =============================================================================
# Worktime Backend — Production Environment Configuration
# =============================================================================
# Reference file for the infra stack (/opt/apps/infra).
# Copy to worktime.env and fill in real values before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Share Directory (mounted network share for .hday files)
# -----------------------------------------------------------------------------
SHARE_DIR=/data/hday_files

# -----------------------------------------------------------------------------
# CORS — must include the frontend domain
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins. In production, use explicit HTTPS
# origins. The frontend domain MUST be included.
#
# Example: https://worktime.tjor.im
CORS_ORIGINS=https://worktime.tjor.im

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL=10

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_ENABLED=true
DATABASE_URL=postgresql+asyncpg://worktime:CHANGE_ME@postgres:5432/worktime
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Authentication — OIDC
# -----------------------------------------------------------------------------
# Worktime validates OIDC/OAuth 2 Bearer JWTs issued by a self-hosted provider
# (Keycloak, authentik, ...). See backend/.env.example for full details.

# OIDC provider base URL. Required in production.
# Keycloak example: https://auth.example.com/realms/worktime
OIDC_ISSUER_URL=https://auth.tjor.im/realms/worktime

# Expected audience claim in access tokens.
OIDC_AUDIENCE=worktime

# JWKS endpoint override. Leave empty to discover jwks_uri from OIDC discovery.
OIDC_JWKS_URI=

# Comma-separated list of accepted JWT signing algorithms.
OIDC_ALGORITHMS=RS256
