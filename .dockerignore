# The backend image builds from the repository root (backend/docker-compose.yml: context `..`, dockerfile
# `backend/Dockerfile`) because it copies /VERSION next to backend/. Docker reads this file from the context root only,
# so keep the context to what the Dockerfile copies.
.git/
.github/
android/
pebble/
hday-helper/
frontend/
docs/
examples/
infra/
scripts/
.venv/
**/.venv/
**/__pycache__/
**/*.pyc
**/.pytest_cache/
**/.ruff_cache/
**/node_modules/
backend/tests/
backend/data/
**/*.db
**/.env
**/.env.*
!**/.env.example
**/.coverage
**/coverage/
