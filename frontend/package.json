{
  "name": "worktime",
  "version": "2026.8.9",
  "description": "Team Shift Tracker + Time Off Management for 5-team continuous (24/7) schedules",
  "keywords": [
    "continuous",
    "hday",
    "shift-tracker",
    "team-schedule",
    "time-off",
    "vacation-tracker",
    "worktime"
  ],
  "homepage": "https://github.com/tjorim/worktime#readme",
  "bugs": {
    "url": "https://github.com/tjorim/worktime/issues"
  },
  "license": "Apache-2.0",
  "author": "Jorim Tielemans <tielemans.jorim@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjorim/worktime.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "dev:playwright:start": "vite --host 0.0.0.0 --port 4173",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "typecheck:tests": "pnpm paraglide:compile && tsc -p tsconfig.test.json --noEmit",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "lint": "oxlint",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "generate-changelog": "tsx scripts/generate-changelog.ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "check-version-consistency": "tsx scripts/check-version-consistency.ts",
    "check-message-parity": "tsx scripts/check-message-parity.ts",
    "sync-version": "tsx scripts/sync-version.ts",
    "generate-roster-fixture": "TSX_TSCONFIG_PATH=./tsconfig.app.json tsx scripts/generate-roster-fixture.ts",
    "check-roster-fixture": "TSX_TSCONFIG_PATH=./tsconfig.app.json tsx scripts/check-roster-fixture.ts"
  },
  "dependencies": {
    "@schedule-x/calendar": "^4.6.1",
    "@schedule-x/drag-and-drop": "^3.7.3",
    "@schedule-x/event-modal": "^4.7.0",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.6.1",
    "@tanstack/query-db-collection": "^1.2.11",
    "@tanstack/react-db": "^0.3.6",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.3",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.1.2",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.23",
    "eventsource-parser": "^4.1.0",
    "frappe-gantt": "^1.2.2",
    "idb-keyval": "6.3.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.2.8",
    "react-bootstrap": "^3.0.0-beta.5",
    "react-dom": "^19.2.8",
    "react-oidc-context": "^3.3.1",
    "react-select": "^5.10.2",
    "temporal-polyfill": "^1.0.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@inlang/plugin-m-function-matcher": "^2.2.12",
    "@inlang/plugin-message-format": "^4.4.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.3.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^4.1.11",
    "canvas": "^3.2.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.11.13",
    "lightningcss": "^1.33.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "sass": "^1.103.1",
    "terser": "^5.50.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
