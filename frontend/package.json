{
  "name": "worktime",
  "version": "2026.9.3",
  "description": "Team Shift Tracker + Time Off Management for 5-team continuous (24/7) schedules",
  "keywords": [
    "continuous",
    "hday",
    "shift-tracker",
    "team-schedule",
    "time-off",
    "vacation-tracker",
    "worktime"
  ],
  "homepage": "https://github.com/tjorim/worktime#readme",
  "bugs": {
    "url": "https://github.com/tjorim/worktime/issues"
  },
  "license": "Apache-2.0",
  "author": "Jorim Tielemans <tielemans.jorim@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjorim/worktime.git"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "vite",
    "dev:playwright:start": "vite --host 0.0.0.0 --port 4173",
    "build": "pnpm paraglide:compile && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "pnpm paraglide:compile && tsc -b --noEmit",
    "typecheck:tests": "pnpm paraglide:compile && tsc -p tsconfig.test.json --noEmit",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --emit-ts-declarations",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "generate-changelog": "tsx scripts/generate-changelog.ts",
    "generate-icons": "tsx scripts/generate-icons.ts",
    "check-version-consistency": "tsx scripts/check-version-consistency.ts",
    "check-message-parity": "tsx scripts/check-message-parity.ts",
    "sync-version": "tsx scripts/sync-version.ts",
    "generate-roster-fixture": "TSX_TSCONFIG_PATH=./tsconfig.app.json tsx scripts/generate-roster-fixture.ts",
    "check-roster-fixture": "TSX_TSCONFIG_PATH=./tsconfig.app.json tsx scripts/check-roster-fixture.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@schedule-x/calendar": "^4.9.1",
    "@schedule-x/drag-and-drop": "^3.7.3",
    "@schedule-x/event-modal": "^4.9.1",
    "@schedule-x/react": "^4.1.0",
    "@schedule-x/theme-default": "^4.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/charts": "^0.18.0",
    "@tanstack/query-db-collection": "^1.3.5",
    "@tanstack/react-db": "^0.5.4",
    "@tanstack/react-form": "2.0.0-alpha.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-table": "^9.2.4",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "dayjs": "^1.11.23",
    "eventsource-parser": "^4.1.1",
    "frappe-gantt": "^1.2.2",
    "idb-keyval": "6.3.0",
    "lucide-react": "^1.49.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-oidc-context": "^3.3.1",
    "react-select": "^5.10.2",
    "tailwindcss": "^4.3.3",
    "temporal-polyfill": "^1.0.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-m-function-matcher": "^2.2.16",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@shadcn/lint": "^0.2.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/ui": "^5.0.3",
    "canvas": "^3.2.3",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.14.5",
    "lightningcss": "^1.33.0",
    "msw": "^2.15.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "postcss": "^8.5.28",
    "terser": "^5.51.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.3",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.33.0",
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
