# =============================================================================
# Worktime Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed for your environment.
# All variables are optional and have sensible development defaults.
#
# Vite only exposes variables prefixed with VITE_ to client-side code.
# =============================================================================

# -----------------------------------------------------------------------------
# OIDC Authentication
# -----------------------------------------------------------------------------
# Configure the OIDC provider for login/logout flows.
#
# VITE_OIDC_AUTHORITY: Base URL of the OIDC provider (authorization server).
#   The frontend appends standard OIDC discovery paths automatically.
#   Must match OIDC_ISSUER_URL in the backend .env.
#
#   Development (authentik default):
#     VITE_OIDC_AUTHORITY=http://localhost:9000/application/o/worktime
#   Keycloak example:
#     VITE_OIDC_AUTHORITY=https://auth.example.com/realms/worktime
#
# VITE_OIDC_CLIENT_ID: OIDC client ID registered with the provider.
#   Create a confidential or public client application in your OIDC provider
#   and paste its ID here. The redirect URI must also be registered.
#
# VITE_OIDC_REDIRECT_URI: Callback URL after successful login.
#   Must be registered as an allowed redirect URI in the OIDC provider.
#   Defaults to {window.location.origin}/auth/callback.
#
# VITE_OIDC_SCOPE: OAuth scopes to request.
#   Default: openid profile email
#   Add custom scopes if your backend validates additional claims.
#
VITE_OIDC_AUTHORITY=http://localhost:9000/application/o/worktime
VITE_OIDC_CLIENT_ID=worktime
# VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
# VITE_OIDC_SCOPE=openid profile email

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
# API requests use the same origin. Vite proxies /api to http://127.0.0.1:8000
# during development; production Caddy routes /api to the backend.
# VITE_API_DOMAIN is not supported.

# -----------------------------------------------------------------------------
# Development helpers
# -----------------------------------------------------------------------------
# VITE_MSW=true  — Enable Mock Service Worker for offline/API-mock development
# VITE_MSW_SCENARIO=demo-default  — Optional default MSW fixture scenario
