# Worktime Backend Environment Configuration
# Copy this file to .env and adjust values as needed

# Environment mode: development or production
ENVIRONMENT=development

# Server configuration
HOST=0.0.0.0
PORT=8000

# Path to directory containing .hday files
# In development: local directory (created automatically)
# In production: path to mounted network share (NFS/SMB)
SHARE_DIR=./data/hday_files

# CORS allowed origins (comma-separated)
# For development: http://localhost:5173
# For production: explicit list of allowed origins
# Never use '*' in production (will be rejected)
CORS_ORIGINS=http://localhost:5173

# Cache configuration
CACHE_ENABLED=true
CACHE_TTL=10
