# =============================================================================
# Worktime Backend Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values as needed for your environment.
# All variables have sensible defaults for development, but should be 
# configured appropriately for production deployments.
#
# For Docker deployments, these can be overridden with -e flags or 
# docker-compose environment sections.
# =============================================================================

# -----------------------------------------------------------------------------
# Environment Mode
# -----------------------------------------------------------------------------
# Controls application behavior and security settings.
# 
# Values: development | production
# - development: Enables auto-reload, relaxed CORS, detailed logging
# - production: Strict security, optimized performance, restricted CORS
#
# Default: development
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Server Configuration
# -----------------------------------------------------------------------------
# Network binding configuration for the FastAPI/Uvicorn server.
#
# HOST: IP address to bind to
#   - 0.0.0.0: Accept connections from any network interface (default)
#             ⚠️  Exposes service to external networks - use with firewall/proxy
#   - 127.0.0.1: Accept only local connections (use if accessed via reverse proxy)
#   - Specific IP: Bind to specific network interface
#
# PORT: TCP port for HTTP server
#   - Default: 8000
#   - Change if port 8000 is already in use
#
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Share Directory Configuration
# -----------------------------------------------------------------------------
# Path to directory containing .hday files (calendar events, time-off data).
#
# Development:
#   - Use local directory: ./data/hday_files
#   - Directory is created automatically if it doesn't exist
#
# Production:
#   - Set to mounted network share path (NFS/SMB/CIFS)
#   - Example (NFS): SHARE_DIR=/mnt/worktime_share
#   - Example (SMB): SHARE_DIR=/mnt/smb/worktime
#   - Ensure the directory is readable/writable by the application user
#
# Docker:
#   - Mount as volume: -v /host/path:/app/data/hday_files
#   - Or use docker-compose volumes section
#   - Example: docker run -v /mnt/nas/worktime:/app/data/hday_files
#
# The health endpoint (/healthz) verifies this directory is accessible.
#
SHARE_DIR=./data/hday_files

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Cross-Origin Resource Sharing (CORS) allowed origins.
# Controls which web origins can make requests to this API.
#
# Format: Comma-separated list of URLs
#   - Single origin: http://localhost:5173
#   - Multiple: http://localhost:5173,https://app.example.com
#
# Development:
#   - Use frontend dev server URL: http://localhost:5173
#   - Can use wildcard '*' for convenience (auto-blocked in production)
#
# Production:
#   - MUST specify explicit list of allowed origins
#   - Never use '*' (rejected for security)
#   - Include all domains/subdomains that need access
#   - Use HTTPS URLs for production frontends
#
# Examples:
#   Development: http://localhost:5173
#   Production: https://worktime.company.com,https://worktime-staging.company.com
#
CORS_ORIGINS=https://worktime.tjor.im

# -----------------------------------------------------------------------------
# Cache Configuration
# -----------------------------------------------------------------------------
# Controls caching behavior for file system operations and API responses.
#
# CACHE_ENABLED: Enable/disable caching
#   - true: Cache enabled (recommended for production)
#   - false: Cache disabled (useful for debugging)
#
# CACHE_TTL: Time-to-live for cached data in seconds
#   - Determines how long cached data remains valid
#   - Lower values: More frequent updates, higher load
#   - Higher values: Better performance, potentially stale data
#   - Recommended: 10-60 seconds depending on update frequency
#
CACHE_ENABLED=true
CACHE_TTL=10

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Controls PostgreSQL database connection and runtime behavior.
#
# DATABASE_ENABLED: Enable/disable database initialization and usage
#   - true: Initialize database at startup
#   - false: Skip DB initialization (for phased rollouts or troubleshooting)
#
# DATABASE_URL: PostgreSQL connection URL (async asyncpg driver)
#   - Format: postgresql+asyncpg://user:password@host:port/dbname
#   - Example (local dev): postgresql+asyncpg://worktime:worktime@localhost/worktime
#   - Example (Docker):    postgresql+asyncpg://worktime:worktime@db/worktime
#
# DATABASE_ECHO: Enable SQL query logging
#   - false: Disable SQL statement logging (recommended)
#   - true: Log generated SQL statements (useful for debugging)
#
DATABASE_ENABLED=true
DATABASE_URL=postgresql+asyncpg://worktime:worktime@localhost/worktime
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
# JWT signing configuration for the built-in login endpoint (POST /v1/auth/token).
# Passwords are stored as Argon2 hashes (via pwdlib[argon2]).
#
# JWT_SECRET_KEY: Shared secret used to sign and verify JWT access tokens.
#   - MUST be changed from the default before deploying to production.
#   - Use a random string of at least 32 characters.
#   - Applies only to HMAC algorithms (HS256, HS384, HS512).
#   - Example (generate): python -c "import secrets; print(secrets.token_hex(32))"
#
# JWT_ALGORITHM: Signing algorithm for JWTs.
#   - Supported: HS256, HS384, HS512
#   - Default: HS256 (symmetric HMAC, suitable for single-server deployments)
#   - RS* and ES* algorithms are not supported by this configuration because they require RSA/ECDSA key pairs instead of JWT_SECRET_KEY.
#
JWT_SECRET_KEY=dev-only-change-me-at-least-32-bytes
JWT_ALGORITHM=HS256
