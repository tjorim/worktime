{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tjorim/renovate-config",
    "github>tjorim/renovate-config:js",
    "github>tjorim/renovate-config:python",
    "github>tjorim/renovate-config:android"
  ],
  "packageRules": [
    {
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "dayjs"
      ],
      "groupName": "dayjs"
    },
    {
      "description": [
        "vite-plugin-pwa generates the service worker that workbox-window registers"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "vite-plugin-pwa",
        "workbox-window"
      ],
      "groupName": "pwa"
    },
    {
      "description": [
        "Schedule-X calendar component and its plugins"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchPackageNames": [
        "@schedule-x/*"
      ],
      "groupName": "schedule-x"
    },
    {
      "description": [
        "frontend/**"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchFileNames": [
        "frontend/**"
      ],
      "addLabels": [
        "platform:frontend"
      ]
    },
    {
      "description": [
        "pebble/**"
      ],
      "matchDatasources": [
        "npm"
      ],
      "matchFileNames": [
        "pebble/**"
      ],
      "addLabels": [
        "platform:pebble"
      ],
      "commitMessagePrefix": "deps(pebble):"
    },
    {
      "description": [
        "backend/**"
      ],
      "matchDatasources": [
        "pypi"
      ],
      "matchFileNames": [
        "backend/**"
      ],
      "addLabels": [
        "platform:backend"
      ],
      "commitMessagePrefix": "deps(backend):"
    },
    {
      "description": [
        "android/**"
      ],
      "matchManagers": [
        "gradle"
      ],
      "matchFileNames": [
        "android/**"
      ],
      "addLabels": [
        "platform:android"
      ],
      "commitMessagePrefix": "deps(android):"
    }
  ]
}
